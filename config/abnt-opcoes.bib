% ==============================================================================
% Opção de citação para o estilo abntex2-alf (não editar)
% NBR 10520:2023: sobrenome em letras minúsculas também entre parênteses,
% como em (Silva, 2024). A entrada equivalente do abntex2-options.bib
% ("abnt-cite-style=AuthorYEAR") é ignorada pelo BibTeX, que não distingue
% maiúsculas de minúsculas nas chaves e a considera duplicata de
% "abnt-cite-style=AUTHORYEAR". Por isso a opção é declarada aqui com outra chave.
% ==============================================================================
@ABNT-options{abnt-citacao-minuscula,
  abnt-cite-style = "(Author, YEAR)",
  key = "aaaa"
}
